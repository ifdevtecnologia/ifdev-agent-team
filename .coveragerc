# Coverage of the tests (`coverage run -m unittest discover -s tests -v`), reported to SonarQube Cloud.
[run]
source = scripts
branch = true
# Paths relative to the repository root, so coverage.xml matches the paths Sonar analyzes.
relative_files = true
# Also measure Python scripts the tests start as subprocesses that inherit the environment
# (for example `sys.executable scripts/context_budget.py`); subprocesses started with a
# minimal environment (PATH and HOME only) are not measured. Each process writes its own data
# file: run `coverage combine` before `coverage report` or `coverage xml`.
patch = subprocess

[report]
precision = 1
